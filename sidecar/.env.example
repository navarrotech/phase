# ---------------------------------------------------------------------------
# phase.rs LLM opponent sidecar
#
# Copy this template to a dotenv file beside it and fill it in. Dotenv files are
# gitignored; never commit a real token. Every value here has a working default
# except the credential, which has two mutually exclusive forms — pick ONE.
# ---------------------------------------------------------------------------

# FORM 1 (recommended): a long-lived subscription token from `claude setup-token`.
# Self-contained, so the sidecar needs no access to your ~/.claude directory.
# The CLI treats this token as non-refreshable — regenerate it when it expires.
CLAUDE_CODE_OAUTH_TOKEN=

# FORM 2: reuse the credentials your local `claude login` already wrote. Leave
# CLAUDE_CODE_OAUTH_TOKEN empty and point this at a WRITABLE config directory
# holding a `.credentials.json`. The CLI rewrites that file when it refreshes
# OAuth, so a read-only mount works until the access token ages out and then
# fails for a reason that looks nothing like a permissions problem.
# CLAUDE_CONFIG_DIR=/home/you/.claude

# Which model answers. Any Claude Code model alias or full model id.
LLM_OPPONENT_MODEL=claude-opus-5

# Port the sidecar listens on. Vite proxies /llm-opponent here in dev.
LLM_OPPONENT_PORT=8788

# Interface to bind. Keep it on loopback: this process holds your credential and
# has no authentication of its own.
LLM_OPPONENT_HOST=127.0.0.1

# Hard ceiling on agentic turns per decision. Raise for deeper deliberation at
# the cost of latency and subscription usage.
LLM_OPPONENT_MAX_TURNS=4

# Let Claude research cards and rulings on the web before deciding. Materially
# slower; off by default.
LLM_OPPONENT_ALLOW_WEB_SEARCH=false

# Reject a decision request whose serialized game state exceeds this many bytes,
# rather than silently truncating the board Claude reasons about.
LLM_OPPONENT_MAX_REQUEST_BYTES=1048576
